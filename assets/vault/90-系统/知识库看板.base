filters:
  and:
    - 'file.ext == "md"'
    - '!file.name.startsWith("00-")'
properties:
  file.name:
    displayName: 笔记
  note.status:
    displayName: 原记录状态
  note.created_at:
    displayName: 内容记录日期
views:
  - type: table
    name: 项目
    filters: 'file.inFolder("01-项目库") && !file.inFolder("01-项目库/待确认是否继续")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 收件箱
    filters: 'file.inFolder("00-灵感库")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 经验复利
    filters: 'file.inFolder("05-技能库") && !file.inFolder("05-技能库/待验证方法")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 待验证方法
    filters: 'file.inFolder("05-技能库/待验证方法")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 待确认项目
    filters: 'file.inFolder("01-项目库/待确认是否继续")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 长期领域
    filters: 'file.inFolder("02-资产库")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 参考资料
    filters: 'file.inFolder("03-资源库")'
    order: [file.name, note.status, note.created_at]
  - type: table
    name: 归档
    filters: 'file.inFolder("04-归档库")'
    order: [file.name, note.status, note.created_at]
